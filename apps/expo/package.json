    "@project-name/eslint-config": "workspace:*",
    "@project-name/prettier-config": "workspace:*",
    "@project-name/tailwind-config": "workspace:*",
    "@project-name/tsconfig": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
